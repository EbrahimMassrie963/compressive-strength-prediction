# Normalise text to LF in the repository so the Linux build on Streamlit
# Cloud gets clean files regardless of the platform that committed them.
* text=auto eol=lf

# Windows batch files must keep CRLF or cmd.exe can mis-parse them.
*.bat text eol=crlf

# Never touch these.
*.joblib binary
*.xls    binary
*.xlsx   binary
*.png    binary
*.pdf    binary
